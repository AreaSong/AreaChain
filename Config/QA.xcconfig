// 仅显式 -xcconfig 的完整 PrivacyQA 构建消费；不写个人签名配置。
AREACHAIN_BUILD_ROLE = qa
AREACHAIN_QA_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER)
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG AREACHAIN_QA
AREACHAIN_SIGNING_MODE = local
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -
CODE_SIGN_ENTITLEMENTS = AreaChain/App/AreaChain.entitlements
// 调用入口必须明确给出完整标识，避免 -xcconfig 优先级覆盖本批身份。
PRODUCT_BUNDLE_IDENTIFIER = $(AREACHAIN_QA_IDENTIFIER)
INFOPLIST_KEY_LSUIElement = NO
