          }
        }
      }
    },
    "privacy.error.staleOperation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content or unlock state changed. Unlock again and retry the operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容或解锁状态已变化，请重新解锁并重试。"
