      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires only a plain title and an explicit valid date. Notes, line breaks, separators, tags, reminders, priority and protected content are unsupported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持普通纯标题与明确合法日期。不支持备注、换行、备注分隔、标签、提醒、优先级或保护内容。"
          }
        }
      },
      "extractionState": "manual"
    },
