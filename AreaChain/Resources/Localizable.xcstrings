    "privacy.cleanup.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage cleanup is pending. Retry image cleanup, then quit and reopen the app to rebuild the database before treating migration as complete. External backups and source images are not removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储清理尚未完成。请重试附件清理，再退出并重新打开应用以重建数据库，之后才可确认迁移完成。外部备份与原始图片不会被删除。"
          }
        }
      }
    },
    "privacy.cleanup.database": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy protection is active. Database storage optimization runs the next time the app launches, before the store is opened. Quit to finish it now; this page will not rebuild an open database."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密保护已生效。数据库底层优化会在下次启动、打开库之前进行。可退出应用以立即完成；本页不会对仍打开的数据库执行重建。"
          }
        }
      }
    },
