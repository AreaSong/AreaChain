    "privacy.migration.backup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and verify an encrypted backup, including images, before conversion. Applying replaces old image files and rebuilds SQLite storage to remove historical plaintext. Other existing backups are not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换前必须保存并校验包含图片的加密备份。确认后将替换旧图片，并重建 SQLite 存储以清理历史明文；其他已有备份不受影响。"
          }
        }
      }
    },
    "privacy.migration.count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld existing notes will be encrypted, including matching notes in Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将加密 %ld 条已有手记，包含回收站中的匹配记录。"
          }
        }
      }
    },
    "privacy.missing.config": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted records exist, but the vault configuration is missing. Do not create a replacement key. Restore the original configuration, or recover an encrypted backup in a fresh environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有加密记录，但缺少私密锁配置。不能新建密钥替代旧密钥；请恢复原配置，或在空环境中恢复加密备份。"
          }
        }
      }
    },
