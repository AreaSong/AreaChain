    "privacy.boundary.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes that match a private tag, and notes that stay protected, keep their text and images private. A private tag encrypts the whole note and its attachments. Removing a tag does not remove existing protection. Plain JSON leaves out protected notes, legacy password-masked notes, and private attachments, and it never includes image bytes. Use the separate-password encrypted backup on Data & Backup. That restore merges records and images; it does not replace the whole library. The privacy migration backup appears only while converting existing notes into private content. It is not the everyday backup entry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命中私密标签的手记，以及仍受保护的手记，正文和图片都属于私密内容。私密标签会加密整条手记和所属附件；移除标签不会自动解除已有保护。普通 JSON 不包含受保护手记、旧密码遮罩手记和私密附件，也不包含图片二进制。记录和图片请到「数据与备份」使用独立口令的加密备份；恢复是合并，不会整库覆盖。将旧手记转为私密内容前的隐私迁移备份，只出现在创建或调整私密保护时，不是日常备份入口。"
          }
        }
      }
    },
    "privacy.boundary.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy boundary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私边界"
          }
        }
      }
    },
    "privacy.backup.export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export encrypted backup…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出加密备份…"
          }
        }
      }
    },
    "privacy.backup.password.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New backups need a passphrase of at least 12 characters. It may differ from your master password and does not depend on this Mac’s keychain. Keep it safely: losing it makes this backup unreadable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新备份口令至少 12 个字符，可与主密码不同，不依赖本机钥匙串。请另行保管：遗失后无法解开这份备份。"
          }
        }
      }
    },
    "privacy.backup.password.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup passphrase"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份口令"
          }
        }
      }
    },
    "privacy.backup.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore encrypted backup…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复加密备份…"
          }
        }
