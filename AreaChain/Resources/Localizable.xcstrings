    "privacy.error.storageFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage did not complete. Check disk space and permissions, preserve existing data, and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储操作未完成。请检查磁盘空间和权限，保留现有数据后重试。"
          }
        }
      }
    },
    "privacy.error.systemCleanupPending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System credential cleanup is incomplete. Preserve the privacy configuration and retry cleanup here before treating system access as revoked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统凭据清理尚未完成。请保留隐私配置并在此重试清理，完成前不能视为系统访问已完全撤销。"
          }
        }
      }
    },
    "privacy.error.systemUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System verification or protected keychain access is unavailable. Try again or use your master password; signing and permissions may need review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统验证或受保护钥匙串不可用。请重试或使用主密码；可能需要检查签名与权限。"
          }
        }
      }
    },
    "privacy.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image or backup manifest exceeds the current limit (64 MiB per image; 16 MiB for the manifest). Reduce its size and retry; no content was silently omitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片或备份清单超过当前上限（单图 64 MiB，清单 16 MiB）。请缩减后重试；不会静默遗漏内容。"
          }
        }
      }
    },
    "privacy.error.unsupportedVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This encrypted format needs a compatible version of AreaChain."
