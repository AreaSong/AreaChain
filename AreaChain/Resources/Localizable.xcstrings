          }
        }
      },
      "extractionState": "manual"
    },
    "unified.task.sourceIssue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source cannot be confirmed or has changed. Nothing was created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源无法确认或已变化，未创建任务。"
