        "zh-Hans": { "stringUnit": { "state": "translated", "value": "本机" } }
      }
    },
    "settings.calendar.conflict.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The AreaChain calendar has no event to compare." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "日历里没有可对照的这一条。" } }
      }
    },
    "settings.calendar.conflict.noTime": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No reminder" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无提醒" } }
      }
    },
    "settings.calendar.conflict.remote": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Calendar" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "日历" } }
      }
    },
    "settings.calendar.openSystem": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open Calendar Settings" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开系统日历设置" } }
      }
    },
    "settings.calendar.sync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统日历"
          }
        }
      }
    },
    "settings.calendar.sync.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only tasks in the AreaChain calendar are synchronized. Conflicting versions and events without a confirmed owner are kept. Deleting an event detaches its task; complete and reopen the task to publish it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只同步 AreaChain 专属日历中的待办。冲突版本及无法确认归属的事件会保留。删除日历事件后待办保持解绑；将待办完成后重新打开，可重新发布。"
          }
        }
      }
    },
    "settings.calendar.sync.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry sync"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新同步"
          }
        }
      }
    },
    "settings.calendar.sync.status.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar differences need review; neither conflicting version was overwritten. The title, date and reminder from this Mac and the calendar are listed below. Align both sides, then retry. If a deleted task should remain, restore it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历差异需要确认，冲突的两边都未被覆盖。下方列出本机和日历的标题、日期和提醒。改到两边一致后再重新同步；若要保留已删除的待办，请先恢复。"
          }
        }
      }
    },
    "settings.calendar.sync.status.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not grant calendar access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没给日历权限。"
          }
        }
      }
    },
    "settings.calendar.sync.status.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync was not completed. Some changes may already be saved; retry to reconcile safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步尚未全部完成，部分更改可能已写入。请重试以安全核对。"
          }
        }
      }
    },
    "settings.calendar.sync.status.localUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar sync is paused because local storage is unavailable or temporary. No calendar changes were written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机库不可用或处于临时内存模式，日历同步已暂停，没有向日历写入或清理事件。"
          }
        }
      }
    },
    "settings.calendar.sync.status.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar sync is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历同步是关的。"
          }
        }
      }
    },
    "settings.calendar.sync.status.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last synced"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次同步"
          }
        }
      }
    },
    "settings.calendar.sync.status.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create the AreaChain calendar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建不了名叫 AreaChain 的日历。"
          }
        }
      }
    },
    "settings.calendar.sync.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync temporary tasks to Calendar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一次性事项同步到系统日历"
          }
        }
      }
    },
    "settings.capture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获"
          }
        }
      }
    },
    "settings.capture.screen.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture current screen asks for Screen Recording once, then attaches a still image to a task or habit. It does not attach to a diary entry or keep recording. If the sandbox blocks it, attach a file or paste instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「截当前屏」会要一次屏幕录制权限，只拍一张图，附到待办或习惯，不附到手记，也不会一直录。若沙盒拦住，仍可用选文件或贴图。"
          }
        }
      }
    },
    "settings.capture.stamp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stamp the frontmost app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记下当时的 App"
          }
        }
      }
    },
    "settings.capture.stamp.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Overlay Return, the Today composer, the paste shortcut, Calendar typing, and tag lists store the frontmost app’s bundle ID. AreaChain itself is not stamped. Window titles are not read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关。打开后，浮层回车、工作台今日输入、剪贴板热键、日历页和标签清单添加待办都会记下前台 App 的标识；前台是 AreaChain 自己则不写。不读窗口标题。"
          }
        }
      }
    },
    "settings.chrome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "dataBackup.encrypted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate-password encrypted backup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立口令加密备份"
          }
        }
      }
    },
    "dataBackup.encrypted.exported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted backup exported. The password was not saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密备份已导出。口令没有写入偏好。"
          }
        }
      }
    },
    "dataBackup.encrypted.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup includes records and image attachments. It uses a separate password that is not saved in preferences. Restore checks the manifest and shows a preview. After you confirm, it merges. Local records outside the backup are not deleted unconditionally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含记录和图片附件，使用独立口令，不会记入应用偏好。恢复前会检查清单并显示预览；确认后按合并方式恢复，不会无条件删除备份之外的本地记录。"
          }
        }
      }
    },
    "dataBackup.encrypted.restored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted backup merged. Records outside the backup were kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密备份已按合并方式恢复。备份之外的本地记录仍保留。"
          }
        }
      }
    },
    "dataBackup.health": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Database health"
