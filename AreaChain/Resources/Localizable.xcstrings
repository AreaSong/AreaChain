    "dev.controls.toggle.motion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches follow system Reduce Motion only; the preview control above applies only to buttons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开关仅遵循系统减弱动态效果；上方预览开关仅作用于按钮。"
          }
        }
      }
    },
