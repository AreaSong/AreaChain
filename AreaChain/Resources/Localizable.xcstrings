            "value": "Verify again to change privacy settings or handle an encrypted backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新验证身份，以修改隐私设置或处理加密备份。"
          }
        }
      }
    },
    "privacy.master.change": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change master password…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换主密码…"
          }
        }
      }
    },
    "privacy.master.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New passwords need at least 12 characters. Use a long, unique passphrase; pasting is supported. No master password is stored in plaintext."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新主密码至少 12 个字符，建议使用不复用的长口令，支持粘贴。不会保存明文主密码。"
          }
        }
      }
    },
    "privacy.master.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AreaChain master password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AreaChain 主密码"
          }
        }
      }
    },
    "privacy.master.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not your Mac login password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是 Mac 登录密码"
          }
        }
      }
    },
    "privacy.master.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove master password…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除主密码…"
          }
        }
      }
    },
    "privacy.master.set": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set master password…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置主密码…"
          }
        }
      }
    },
    "privacy.methods.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable either or both; one successful method unlocks the vault. System verification may accept the Mac login password. Keep at least one usable method."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以单独或同时启用，任意一种成功即可解锁。系统验证可能接受 Mac 登录密码；必须保留至少一种可用方式。"
          }
        }
      }
    },
    "privacy.methods.master": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent AreaChain master password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立的 AreaChain 主密码"
          }
        }
      }
    },
    "privacy.methods.system": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System verification (Touch ID / Mac password)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统验证（Touch ID／Mac 登录密码）"
          }
        }
      }
    },
    "privacy.migration.backup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and verify an encrypted backup, including images, before conversion. Applying replaces old image files and rebuilds SQLite storage to remove historical plaintext. Other existing backups are not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换前必须保存并校验包含图片的加密备份。确认后将替换旧图片，并重建 SQLite 存储以清理历史明文；其他已有备份不受影响。"
          }
        }
      }
    },
    "privacy.migration.count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld existing notes will be encrypted, including matching notes in Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将加密 %ld 条已有手记，包含回收站中的匹配记录。"
          }
        }
      }
    },
    "privacy.missing.config": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted records exist, but the vault configuration is missing. Do not create a replacement key. Restore the original configuration, or recover an encrypted backup in a fresh environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有加密记录，但缺少私密锁配置。不能新建密钥替代旧密钥；请恢复原配置，或在空环境中恢复加密备份。"
          }
        }
      }
    },
    "privacy.password.repeat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次输入口令"
          }
        }
      }
    },
    "privacy.restore.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore this encrypted backup?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复这份加密备份？"
          }
        }
      }
    },
    "privacy.restore.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore %ld notes and %ld images, plus the included tasks and settings metadata. Matching IDs will be updated; records absent from the backup will remain. Private content stays encrypted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将恢复 %ld 条手记和 %ld 张图片，以及备份中的任务和分类数据。同标识记录会被更新，备份未包含的记录保留；私密内容继续加密。"
          }
        }
      }
    },
    "privacy.settings.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password masking alone does not encrypt storage. Enable privacy protection to encrypt selected notes and images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前的密码遮罩不等于加密。启用后，选定手记和图片将加密存储。"
          }
        }
      }
    },
    "privacy.settings.saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation completed. Check any pending storage-cleanup notice below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已提交；如有待清理提示，请继续处理后再确认迁移完成。"
          }
        }
      }
    },
