      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a single active draft with an empty plan, or one plan item. Finish parameter and plan editing first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
