    "privacy.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification is in progress or temporarily rate-limited. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证或暂时限制重试，请稍后再试。"
          }
        }
      }
    },
    "privacy.error.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. No access was granted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已取消，未授予访问权限。"
          }
        }
      }
    },
    "privacy.error.corruptData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected content or its format could not be verified. Keep the original data and try a verified backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法校验受保护内容或其格式。请保留原数据，尝试已验证的备份。"
          }
        }
      }
    },
    "privacy.error.lastMethod": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep at least one verified unlock method."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须保留至少一种已验证可用的解锁方式。"
          }
        }
      }
    },
    "privacy.error.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock private notes before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先解锁私密手记，再继续操作。"
          }
        }
      }
    },
    "privacy.error.missingAttachment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An image is missing. A complete backup cannot be created; no images were silently omitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片文件缺失，无法创建完整备份；不会静默遗漏图片。"
          }
        }
      }
    },
    "privacy.error.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up the private vault first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先设置私密保护。"
          }
        }
      }
    },
    "privacy.error.privateImport": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation would bypass existing protection. Review private tags, or restore a verified encrypted backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该操作会绕过已有保护。请先处理私密标签，或恢复经过验证的加密备份。"
          }
        }
      }
    },
    "privacy.error.requiresBackup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and verify an encrypted backup before converting existing notes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换已有手记前，必须保存并验证加密备份。"
          }
        }
      }
    },
    "privacy.error.staleOperation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content or unlock state changed. Unlock again and retry the operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容或解锁状态已变化，请重新解锁并重试。"
          }
        }
      }
    },
    "privacy.error.storageFailure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage did not complete. Check disk space and permissions, preserve existing data, and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储操作未完成。请检查磁盘空间和权限，保留现有数据后重试。"
          }
        }
      }
    },
    "privacy.error.systemCleanupPending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System credential cleanup is incomplete. Preserve the privacy configuration and retry cleanup here before treating system access as revoked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统凭据清理尚未完成。请保留隐私配置并在此重试清理，完成前不能视为系统访问已完全撤销。"
          }
        }
      }
    },
    "privacy.error.systemUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System verification or protected keychain access is unavailable. Try again or use your master password; signing and permissions may need review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统验证或受保护钥匙串不可用。请重试或使用主密码；可能需要检查签名与权限。"
          }
        }
      }
    },
    "privacy.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image or backup manifest exceeds the current limit (64 MiB per image; 16 MiB for the manifest). Reduce its size and retry; no content was silently omitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片或备份清单超过当前上限（单图 64 MiB，清单 16 MiB）。请缩减后重试；不会静默遗漏内容。"
          }
        }
      }
    },
    "privacy.error.unsupportedVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This encrypted format needs a compatible version of AreaChain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该加密格式需要兼容版本的 AreaChain。"
          }
        }
      }
    },
    "privacy.error.weakPassword": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a passphrase of at least 12 characters and at most 4096 UTF-8 bytes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用至少 12 个字符、最长 4096 字节的口令。"
          }
        }
      }
    },
    "privacy.error.wrongPassword": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password is incorrect, or the protected key cannot be verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令不正确，或受保护密钥无法通过校验。"
          }
        }
      }
    },
