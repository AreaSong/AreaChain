      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Single and batch completion differ for skipped occurrences; semantics require a decision."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "单条与批量完成对跳过记录的处理不同，需先核定语义。"}}
      }
    },
    "command.reason.privateTagTransition": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Tag links can trigger protection conversion and require the existing protection flow."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "标签关联可能触发保护转换，需按既有保护门禁接入。"}}
      }
    },
    "command.reason.privateTagMerge": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Protection behavior when merging into private tags is unresolved."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "合并到私密标签的保护处理尚未决定。"}}
      }
    },
    "command.reason.globalUnlink": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Global unlink exists only in the repository; a user action is not established."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "现有全局解绑只有仓储能力，尚无独立用户入口。"}}
      }
    },
    "command.reason.presetCleanup": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Existing cleanup includes unused preset tags; the command scope requires a decision."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "现有清理包含未使用预置标签，指令范围需核定。"}}
      }
    },
    "command.reason.backupWithoutLock": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Backup export availability without a configured lock requires a product decision."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "未配置私密锁时的备份导出可达性需要产品决定。"}}
      }
    },
    "command.reason.recoveryDesign": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Reset recovery lacks complete failure results and recovery points; it is unavailable."}},
