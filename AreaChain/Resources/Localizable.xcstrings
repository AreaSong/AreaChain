    "privacy.restore.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore %ld notes and %ld images, plus the included tasks and settings metadata. Matching IDs will be updated; records absent from the backup will remain. Private content stays encrypted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将恢复 %ld 条手记和 %ld 张图片，以及备份中的任务和分类数据。同标识记录会被更新，备份未包含的记录保留；私密内容继续加密。"
          }
        }
      }
    },
    "privacy.settings.intro": {
      "extractionState": "manual",
      "localizations": {
