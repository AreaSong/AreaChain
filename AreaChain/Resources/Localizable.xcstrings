    "shortcut.openDiary.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the selected diary. Return alone still opens it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开选中的手记。单独按回车仍会打开。"
          }
        }
      }
    },
    "shortcut.page.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a shortcut, then press a new combination. It must include ⌘, ⌥, or ⌃. The one you just set stays on, and the previous item using that combination turns off. Esc cancels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下右侧组合，再按下新的快捷键。必须包含 ⌘、⌥ 或 ⌃。刚录下的生效，原来占用这个组合的一项会停用。Esc 取消。"
          }
        }
      }
    },
    "shortcut.page.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global shortcuts work in any app and start unset. Arrow keys, Space, Return, Delete, and Esc stay list actions. ⌘Return in notes still submits the note."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局热键在任意应用前台生效，默认不绑定。方向键、空格、回车、Delete 和 Esc 仍是清单里的行内操作。备注里的 ⌘Return 仍用来提交备注。"
          }
        }
      }
    },
