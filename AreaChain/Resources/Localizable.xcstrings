    "settings.calendar.sync.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync temporary tasks to Calendar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把临时任务同步到系统日历"
          }
        }
      }
    },
    "settings.calendar.sync.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Creates an AreaChain calendar and mirrors open temporary tasks. Resident tasks stay out. Other people’s events are not imported. Notifications still come from AreaChain, not EventKit alarms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关。打开后会建一个名叫 AreaChain 的日历，只同步未完成的临时任务。常驻不同步，也不把别人的会议收进来。到点提醒仍走本机通知，不改成日历闹钟。"
          }
        }
      }
    },
    "settings.capture.screen.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture current screen asks for Screen Recording once, then saves a still image. AreaChain does not keep recording. If the sandbox blocks it, attach a file or paste instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「截当前屏」会要一次屏幕录制权限，只拍一张图，不会一直录。若沙盒拦住，仍可用选文件或贴图。"
          }
        }
      }
    },
