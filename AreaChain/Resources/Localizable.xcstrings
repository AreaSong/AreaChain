        "zh-Hans": { "stringUnit": { "state": "translated", "value": "全局热键在任意应用前台生效，默认不绑定。方向键、空格、回车、Delete 和 Esc 仍是清单里的行内操作。备注里的 ⌘Return 仍用来提交备注。" } }
      }
