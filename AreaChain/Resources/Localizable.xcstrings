    "privacy.cleanup.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage cleanup is pending. Retry image cleanup, then quit and reopen the app to rebuild the database before treating migration as complete. External backups and source images are not removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储清理尚未完成。请重试附件清理，再退出并重新打开应用以重建数据库，之后才可确认迁移完成。外部备份与原始图片不会被删除。"
          }
        }
      }
    },
    "privacy.cleanup.database": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy protection is active. Database storage optimization is scheduled. You can optimize now or let it finish automatically on next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密保护已生效。数据库已安排底层存储优化，点击可立即完成，亦可在下次启动时自动处理。"
          }
        }
      }
    },
