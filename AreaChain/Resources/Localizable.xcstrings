    "hotkey.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works while another app is in front. Unset until you record one. A shortcut already saved on this Mac stays. It must include ⌘, ⌥, or ⌃. Esc cancels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别的应用在前台时也能用。默认不绑定；这台 Mac 上已经录过的会保留。必须包含 ⌘、⌥ 或 ⌃。Esc 取消。"
          }
        }
      }
    },
