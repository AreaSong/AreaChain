    "#%@": {
      "comment": "A tag label. The argument is the name of the tag.",
      "isCommentAutoGenerated": true
    },
    "%lld": {
      "comment": "A label that shows the number of tasks on a given day. The argument is the number of tasks on that day.",
      "isCommentAutoGenerated": true
    },
    "%lld/%lld": {
      "comment": "A label showing the number of completed and total subtasks. The first argument is the number of completed subtasks. The second argument is the number of total subtasks.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld%%": {
      "comment": "A label showing the percentage of the day that has been completed. The argument is the percentage, rounded to the nearest whole number.",
      "isCommentAutoGenerated": true
    },
    "••••••••••••••••": {
      "comment": "A placeholder for a masked password.",
      "isCommentAutoGenerated": true
    },
    "↑↓": {
      "comment": "A key that moves the cursor up or down.",
      "isCommentAutoGenerated": true
    },
    "⇥ / ↵": {
      "comment": "A key combination for autocompleting text.",
      "isCommentAutoGenerated": true
    },
