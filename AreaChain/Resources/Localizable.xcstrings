          }
        }
      }
    },
    "privacy.master.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New passwords need at least 12 characters. Use a long, unique passphrase; pasting is supported. No master password is stored in plaintext."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新主密码至少 12 个字符，建议使用不复用的长口令，支持粘贴。不会保存明文主密码。"
          }
        }
      }
    },
    "privacy.master.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AreaChain master password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AreaChain 主密码"
          }
        }
      }
    },
    "privacy.master.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not your Mac login password"
          }
        },
        "zh-Hans": {
