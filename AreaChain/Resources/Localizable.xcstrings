    "hotkey.clipboard.help": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Shows or hides the clipboard panel. Unset until you record one. Press again to close. Closing the workspace leaves the panel open. Return copies, ⌥Return pastes, and ⌥⇧Return pastes plain text." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开或关闭剪贴板小窗。默认不绑定。再按一次关闭。关掉工作台不会关掉小窗。回车复制，⌥回车粘贴，⌥⇧回车粘贴纯文本。" } }
      }
