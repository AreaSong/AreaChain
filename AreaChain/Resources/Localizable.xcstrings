    "privacy.methods.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable either or both; one successful method unlocks the vault. System verification may accept the Mac login password. Keep at least one usable method."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以单独或同时启用，任意一种成功即可解锁。系统验证可能接受 Mac 登录密码；必须保留至少一种可用方式。"
          }
        }
      }
    },
    "privacy.methods.master": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent AreaChain master password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立的 AreaChain 主密码"
          }
        }
      }
    },
    "privacy.methods.system": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System verification (Touch ID / Mac password)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统验证（Touch ID／Mac 登录密码）"
          }
        }
      }
    },
    "privacy.migration.backup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and verify an encrypted backup, including images, before conversion. Applying replaces old image files and rebuilds SQLite storage to remove historical plaintext. Other existing backups are not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换前必须保存并校验包含图片的加密备份。确认后将替换旧图片，并重建 SQLite 存储以清理历史明文；其他已有备份不受影响。"
          }
        }
      }
    },
    "privacy.migration.count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%ld existing notes will be encrypted, including matching notes in Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将加密 %ld 条已有手记，包含回收站中的匹配记录。"
          }
        }
      }
    },
    "privacy.missing.config": {
