    "privacy.system.only.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System-only unlock depends on this Mac’s keychain and the app’s signing identity. Reinstallation, moving to another Mac, or a signing change may prevent access. Keep an encrypted backup; using a master password as well is recommended."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅系统验证依赖本机钥匙串和应用签名。重装、换机或签名变化可能导致无法解锁。请保留加密备份，建议同时设置主密码。"
          }
        }
      }
    },
    "privacy.system.signing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build cannot access the protected keychain. Stable signing or appropriate entitlements may be required. You can use a master password; the app will not fall back to an unprotected keychain item."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建无法访问受保护钥匙串，可能需要稳定签名或正确权限。可以使用主密码；不会降级为无验证的钥匙串条目。"
          }
        }
      }
    },
