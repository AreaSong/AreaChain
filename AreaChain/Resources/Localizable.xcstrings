    "shortcut.page.help": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Click a shortcut, then press a new combination. It must include ⌘, ⌥, or ⌃. The one you just set stays on, and the previous item using that combination turns off. Esc cancels." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "点一下右侧组合，再按下新的快捷键。必须包含 ⌘、⌥ 或 ⌃。刚录下的生效，原来占用这个组合的一项会停用。Esc 取消。" } }
      }
    },
    "shortcut.page.scope": {
      "extractionState": "manual",
      "localizations": {
