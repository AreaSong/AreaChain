{
  "sourceLanguage": "en",
  "strings": {
    "unified.batch.finalCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All fixed targets are checked together before saving; any conflict rejects the batch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共同保存前统一核对全部固定目标；任一冲突则整项拒绝。"
          }
        }
      }
    },
    "unified.batch.shapeValid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parameters are complete. Preview and accept the batch effects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数完整，请预览并接受整批影响。"
          }
        }
      }
    },
    "unified.routineCreate.unspecified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not supplied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提供"
          }
        }
      }
    },
    "unified.routineCreate.savedTags": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine and tags saved together: %lld created, %lld restored, %lld live tags linked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习惯与标签已共同保存：新建 %lld 个、恢复 %lld 个、关联现有标签 %lld 个。"
          }
        }
      }
    },
    "unified.routineCreate.accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept routine creation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受习惯新增效果"
          }
        }
      }
    },
    "unified.routineCreate.capability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create one ordinary routine with a title and selected weekdays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增一个普通习惯，填写标题并选择星期。"
          }
        }
      }
    },
    "unified.routineCreate.create": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create routine"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增习惯"
          }
        }
      }
    },
    "unified.routineCreate.dateChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The creation day changed. Preview and accept again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建日期已变化，请重新预览并接受。"
          }
        }
      }
    },
    "unified.routineCreate.defaults": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled from %@ · Order %lld across all routines · No source stamp or checks. Creation time is recorded when saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %@ 起启用 · 全部习惯中的排序值 %lld · 无来源标记和打卡记录。创建时刻在提交时记录。"
          }
        }
      }
    },
    "unified.routineCreate.held": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run retains its input and result. Repeated actions do not create another routine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原运行保留输入与结果；重复操作不会另建习惯。"
          }
        }
      }
    },
    "unified.routineCreate.input": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the title, weekdays and optional fields. Notes are not supported here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对标题、星期和可选属性；此处不支持备注。"
          }
        }
      }
    },
    "unified.routineCreate.notSubmitted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine was not submitted. Your input is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习惯尚未提交，原输入已保留。"
          }
        }
      }
    },
    "unified.routineCreate.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creation is pending; no saved routine is confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增仍在处理中，尚未确认习惯已保存。"
          }
        }
      }
    },
    "unified.routineCreate.prepare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview routine creation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览习惯新增效果"
          }
        }
      }
    },
    "unified.routineCreate.saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine saved locally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习惯已在本地保存。"
          }
        }
      }
    },
    "unified.routineCreate.sortChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The routine order changed or could not be read reliably. Preview again after checking it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "习惯排序已变化或无法可靠读取，请核对后重新预览。"
          }
        }
      }
    },
    "unified.routineCreate.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preview is no longer valid. Preview and accept again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份预览已失效，请重新预览并接受。"
          }
        }
      }
    },
    "unified.routineCreate.unassembled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine creation is unavailable in this host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此宿主尚未装配习惯新增。"
          }
        }
      }
    },
    "unified.routineCreate.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creation result is unknown. Keep this identity and verify; do not create again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增结果未知。请保留本次身份并核验，不要再次创建。"
          }
        }
      }
    },
    "unified.routineCreate.weekdays": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select at least one valid weekday."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少选择一个有效星期。"
          }
        }
      }
    },
    "unified.chain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-step task plan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两步任务计划"
          }
        }
      }
    },
    "unified.chain.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each step saves separately. A failed second step keeps the task created in step one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一步分别保存。第二步失败时，第一步创建的任务仍保留。"
          }
        }
      }
    },
    "unified.chain.unassembled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isolated host has no two-step adapter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前隔离宿主未装配两步执行能力。"
          }
        }
      }
    },
    "unified.chain.dependency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 2 will modify the task created by step 1. Its real baseline is read after creation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二步将修改第一步创建的任务；创建成功后才读取真实原值。"
          }
        }
      }
    },
    "unified.chain.minimal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 1 accepts only a plain title and task date. Queue both steps and bind step 2 to the creation output."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一步仅接受普通标题和任务日期。请将两步入列，并将第二步目标绑定到创建输出。"
          }
        }
      }
    },
    "unified.chain.prepare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare step 1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备第一步"
          }
        }
      }
    },
    "unified.chain.prepared": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 1 is prepared. Step 2 still needs a new review and confirmation after creation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一步已准备。创建后仍需重新检查并确认第二步。"
          }
        }
      }
    },
    "unified.chain.create": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm and create step 1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认并执行第一步创建"
          }
        }
      }
    },
    "unified.chain.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task created. Waiting for a fresh review and explicit confirmation of step 2."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已创建，等待检查真实影响并明确确认第二步。"
          }
        }
      }
    },
    "unified.chain.prepareTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the actual task for step 2"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查第二步的真实任务影响"
          }
        }
      }
    },
    "unified.chain.saveTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save step 2"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存第二步修改"
          }
        }
      }
    },
    "unified.chain.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 2 is blocked: step 1 or its required effects are not confirmed successful. Unknown results cannot be replayed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二步被阻断：第一步或其必要外部步骤尚未确认成功。结果未知时不能重放。"
          }
        }
      }
    },
    "unified.chain.shape": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only exactly two steps are supported: plain task creation → title change using its real output. Other shapes or parameters cannot run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持正好两步：普通任务创建 → 使用其真实输出修改标题。其他形状或参数不可执行。"
          }
        }
      }
    },
    "unified.field.accept": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this field change"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认这项属性修改"
          }
        }
      }
    },
    "unified.field.accepted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These changes are accepted. Nothing is saved yet. Next: Save changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认这些变化，尚未保存。下一步：保存修改。"
          }
        }
      }
    },
    "unified.field.baseline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current values have not been reliably read. Select a target and prepare changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无可靠的当前值，请选择目标并准备影响。"
          }
        }
      }
    },
    "unified.field.catalog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not submitted: the tag catalog changed. Prepare and accept the changes again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提交：标签目录已变化，请重新准备并确认影响。"
          }
        }
      }
    },
    "unified.field.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "will change"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将修改"
          }
        }
      }
    },
    "unified.field.changes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current → final values"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前值 → 最终值"
          }
        }
      }
    },
    "unified.field.dirty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not submitted: other edits are unsaved. They have been kept; finish them before reviewing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提交：上下文还有未保存编辑，原修改已保留；处理后请重新查看影响。"
          }
        }
      }
    },
    "unified.field.environment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not submitted: this isolated environment is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提交：当前隔离环境不可用。"
          }
        }
      }
    },
    "unified.field.externalFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes remain saved locally. A notification or calendar consumer reported failure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地修改仍已保存；通知或日历消费者报告失败。"
          }
        }
      }
    },
    "unified.field.fields": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not submitted: a field involved in this edit changed. Review the current values again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提交：本次影响字段已变化，请重新查看当前值。"
          }
        }
      }
    },
    "unified.field.finalTags": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final tag associations, in order"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终标签关联顺序"
          }
        }
      }
    },
    "unified.field.held": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original run and input are retained. Return to plan, retry and undo after execution are not available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原运行与输入保留；暂不支持返回计划、重试或执行后撤销。"
          }
        }
      }
    },
    "unified.field.important": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Important"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重要"
          }
        }
      }
    },
    "unified.field.input": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one valid date, priority, reminder time, or explicit cancellation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择有效日期、优先级、提醒时刻，或明确取消提醒。"
          }
        }
      }
    },
    "unified.field.inputHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Field input keeps its original syntax. Prepare changes to read the current task; notes and line breaks cannot be submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属性输入保留原始语法。准备影响后读取当前任务；备注和换行不能提交。"
          }
        }
      }
    },
    "unified.field.kept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "unchanged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持不变"
          }
        }
      }
    },
    "unified.field.noChange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All effects already match. No save or publication is needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部效果已满足，无需保存或发布。"
          }
        }
      }
    },
    "unified.field.noReminder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reminder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无提醒"
          }
        }
      }
    },
    "unified.field.noTags": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No linked tags"
          }
        },
        "zh-Hans": {
          "stringUnit": {
