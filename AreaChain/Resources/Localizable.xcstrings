        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用本机磁盘库。"
          }
        }
      }
    },
    "dataBackup.json": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain JSON"
          }
        },
        "zh-Hans": {
