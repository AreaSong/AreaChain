    "dataBackup.json.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export or import ordinary records and attachment metadata. Protected notes, legacy password-masked notes, private attachments, and image bytes are excluded. Import validates and shows a preview, then writes only after you confirm. It does not replace the whole library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出或导入普通记录和附件元数据。不包含受保护手记、旧密码遮罩手记、私密附件和图片二进制。导入会先校验并显示预览，确认后才写入，不会整库覆盖。"
          }
        }
      }
    },
