    "settings.calendar.sync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统日历"
          }
        }
      }
    },
    "settings.calendar.sync.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only tasks in the AreaChain calendar are synchronized. Conflicting versions and events without a confirmed owner are kept. Deleting an event detaches its task; complete and reopen the task to publish it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只同步 AreaChain 专属日历中的待办。冲突版本及无法确认归属的事件会保留。删除日历事件后待办保持解绑；将待办完成后重新打开，可重新发布。"
          }
        }
      }
    },
    "settings.calendar.sync.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry sync"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新同步"
          }
        }
      }
    },
    "settings.calendar.sync.status.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar differences need review; neither conflicting version was overwritten. Open the task below and align its title, date and reminder with the AreaChain calendar, then retry. If a deleted task should remain, restore it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历差异需要确认，冲突的两边都未被覆盖。打开下方待办，在待办或 AreaChain 日历中核对标题、日期和提醒，使两边一致后重试；若要保留已删除的待办，请先恢复。"
          }
        }
      }
    },
    "settings.calendar.sync.status.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not grant calendar access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没给日历权限。"
          }
        }
      }
    },
    "settings.calendar.sync.status.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync was not completed. Some changes may already be saved; retry to reconcile safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步尚未全部完成，部分更改可能已写入。请重试以安全核对。"
          }
        }
      }
    },
    "settings.calendar.sync.status.localUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar sync is paused because local storage is unavailable or temporary. No calendar changes were written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机库不可用或处于临时内存模式，日历同步已暂停，没有向日历写入或清理事件。"
          }
        }
      }
    },
    "settings.calendar.sync.status.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar sync is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历同步是关的。"
          }
        }
      }
    },
    "settings.calendar.sync.status.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last synced"
          }
