        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘-click names or bars to select multiple items; Shift-click selects a range. Drag to reschedule together, or use ←/→ to move one day. Esc cancels a drag. Recurring dots mark scheduled weekdays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 点选名称或色块可多选，Shift 连选；拖动一起改期，←/→ 平移一天，Esc 取消拖动。重复事项圆点表示排定日。"
          }
        }
      }
