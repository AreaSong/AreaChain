    "privacy.backup.password.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New backups need a passphrase of at least 12 characters. It may differ from your master password and does not depend on this Mac’s keychain. Keep it safely: losing it makes this backup unreadable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新备份口令至少 12 个字符，可与主密码不同，不依赖本机钥匙串。请另行保管：遗失后无法解开这份备份。"
          }
        }
      }
    },
    "privacy.backup.password.title": {
      "extractionState": "manual",
      "localizations": {
