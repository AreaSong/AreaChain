          "stringUnit": {
            "state": "translated",
            "value": "The pause exceeds 4,000 days. The entire change is rejected and the habit stays paused; no truncation or automatic batching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停区间超过 4000 日，整项拒绝并保持暂停；不会截断或自动分批。"
          }
        }
      }
    },
