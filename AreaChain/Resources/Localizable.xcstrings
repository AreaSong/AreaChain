          "stringUnit": {
            "state": "translated",
            "value": "Backup passphrase"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份口令"
          }
        }
      }
    },
    "privacy.backup.restore": {
      "extractionState": "manual",
      "localizations": {
